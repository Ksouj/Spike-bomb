// SOM PERSONALIZADO - toca só o seu som (o "boom" do sounds.h)
// Ligação: D25 -> fio de sinal | GND -> outro fio de áudio
// O sounds.h precisa estar NESTA pasta, ao lado deste .ino.
//
// Toca uma vez ao ligar e depois a cada 5 s. Pelo Serial Monitor (115200):
// qualquer tecla toca de novo, "0" para.

#include "sounds.h"

#ifndef HAS_SND_BOOM
#error "Faltou o som 'boom'. Gere o sounds.h com: python wav2h.py boom=seu_arquivo.mp3,0,0"
#endif

#define DAC_PIN     25
#define SAMPLE_RATE 16000

hw_timer_t *audioTimer = NULL;
volatile const uint8_t *clipData = NULL;
volatile uint32_t clipLen = 0;
volatile uint32_t clipPos = 0;

void IRAM_ATTR onAudioTimer() {
  uint8_t out = 128;
  if (clipData != NULL) {
    if (clipPos < clipLen) {
      out = clipData[clipPos++];
    } else {
      clipData = NULL;
    }
  }
  dacWrite(DAC_PIN, out);
}

void audioBegin() {
  dacWrite(DAC_PIN, 128);
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  audioTimer = timerBegin(16000000);
  timerAttachInterrupt(audioTimer, &onAudioTimer);
  timerAlarm(audioTimer, 1000, true, 0);
#else
  audioTimer = timerBegin(0, 5, true);
  timerAttachInterrupt(audioTimer, &onAudioTimer, true);
  timerAlarmWrite(audioTimer, 1000, true);
  timerAlarmEnable(audioTimer);
#endif
}

void soundPlay(const uint8_t *d, uint32_t n) { clipData = NULL; clipPos = 0; clipLen = n; clipData = d; }
void soundStop()   { clipData = NULL; }
bool clipPlaying() { return clipData != NULL; }

unsigned long nextPlay = 0;

void playBoom() {
  Serial.print("Tocando boom (");
  Serial.print(snd_boom_len / 16000.0, 1);
  Serial.println(" s)");
  soundPlay(snd_boom, snd_boom_len);
}

void setup() {
  Serial.begin(115200);
  delay(300);
  audioBegin();
  Serial.println("SOM PERSONALIZADO no D25");
  Serial.println("Qualquer tecla toca de novo, 0 para.");
  nextPlay = millis() + 500;
}

void loop() {
  if (Serial.available()) {
    char c = Serial.read();
    if (c == '0') {
      soundStop();
      nextPlay = millis() + 600000;   // pausa a repeticao por 10 min
    } else if (c != '\n' && c != '\r') {
      playBoom();
      nextPlay = millis() + 5000;
    }
  }
  if (!clipPlaying() && millis() > nextPlay) {
    playBoom();
    nextPlay = millis() + (uint32_t)(snd_boom_len / 16.0) + 5000;
  }
}
